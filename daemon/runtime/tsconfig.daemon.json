{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "../../dist",
    "rootDir": "../..",
    "declaration": false,
    "sourceMap": true,
    "isolatedModules": false,
    "paths": {}
  },
  "include": [
    "../../daemon/**/*.ts",
    "../../meta/intent.ts",
    "../../src/db/schema.ts"
  ],
  "exclude": [
    "../../node_modules",
    "../../ui",
    "../../tests",
    "../../src/agents",
    "../../src/index.ts"
  ]
}
